# Copy to .env.local (frontend) / backend/.env -- never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Firebase / Firestore (backend). Locally use GOOGLE_APPLICATION_CREDENTIALS (path to a
# service-account JSON); on Vercel paste the full JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=cryptpilot-madhav-01
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

RESEND_API_KEY=
EMAIL_FROM=
HR_ALERT_EMAIL=

# Frontend -> backend. In production this must be the backend's public https URL
# (set in the Vercel project's environment variables; it is baked in at build time).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production CORS: comma-separated exact origins (e.g. https://app.example.com).
# Leave unset in dev -- localhost/127.0.0.1 (any port) is always allowed.
ALLOWED_ORIGINS=

# Frontend Firebase web app config (Firebase console -> Project settings -> Your apps); put in frontend/.env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- CryptPilot bridge (names only; no secrets here) -------------------------------------------------------------
# The browser only talks to the FinPilot API at /api/crypto/*; the API proxies to the crypto service (vendored Cryptiq).
# Base URL of the crypto service (server-side only, never sent to the browser). Empty string disables the bridge.
# Standard local port for the crypto service is 8132 (what scripts/run_cryptpilot_demo.* uses); the API's own code default
# is 8200 when this is unset, so always set it explicitly.
CRYPTO_SERVICE_URL=http://127.0.0.1:8132
# Set to true only when the FinPilot API sits behind a proxy you control: then X-Forwarded-For / X-Forwarded-Proto are
# believed (per-visitor rate limiting, Secure-cookie handling). Leave unset for local dev.
CRYPTO_TRUST_PROXY=

# ---- Optional FinPilot integrations (names only; every one is optional, the app falls back to offline behaviour) ----
# Local Firestore emulator (instead of a service account): host:port, and the project id to use with it.
FIRESTORE_EMULATOR_HOST=
FIRESTORE_PROJECT_ID=
# NVIDIA-hosted models (chat / council / evidence / vision / embeddings). Keys are per feature.
NVIDIA_API_KEY=
NVIDIA_CHAT_API_KEY=
NVIDIA_EVIDENCE_API_KEY=
NVIDIA_VISION_API_KEY=
NVIDIA_MODEL=
NVIDIA_CHAT_MODEL=
NVIDIA_COUNCIL_MODEL=
NVIDIA_VISION_MODEL=
NVIDIA_EMBED_MODEL=
# Web search / scraping and a second LLM provider.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
NUGEN_API_KEY=
NUGEN_MODEL=
# Inngest background jobs. INNGEST_DEV=1 uses the local dev server.
INNGEST_BASE_URL=
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_JOB_TOKEN=
# Account Aggregator / bank connectors (mock provider by default).
AA_PROVIDER=
AA_BASE_URL=
AA_MOCK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=
PLAID_COUNTRIES=
SETU_STATUS_WEBHOOK_SECRET=
# Number of proxy hops to trust when CRYPTO_TRUST_PROXY=true.
CRYPTO_TRUSTED_HOPS=
# The crypto-service has its own settings (RATE_LIMIT_*, MAX_*, THRESHOLD_*, ...): see crypto-service/.env.example.
