# Copy to .env.local (frontend) / backend/.env -- never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Firebase / Firestore (backend). Locally use GOOGLE_APPLICATION_CREDENTIALS (path to a
# service-account JSON); on Vercel paste the full JSON into FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=hackmatrix-3764f
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

RESEND_API_KEY=
EMAIL_FROM=
HR_ALERT_EMAIL=

# Frontend -> backend. In production this must be the backend's public https URL
# (set in the Vercel project's environment variables; it is baked in at build time).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production CORS: comma-separated exact origins (e.g. https://app.example.com).
# Leave unset in dev -- localhost/127.0.0.1 (any port) is always allowed.
ALLOWED_ORIGINS=

# Frontend Firebase web app config (Firebase console -> Project settings -> Your apps); put in frontend/.env.local.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---- CryptPilot bridge (names only; no secrets here) -------------------------------------------------------------
# The browser only talks to the FinPilot API at /api/crypto/*; the API proxies to the crypto service (vendored Cryptiq).
# Base URL of the crypto service (server-side only, never sent to the browser). Empty string disables the bridge.
# Standard local port for the crypto service is 8132 (what scripts/run_cryptpilot_demo.* uses); the API's own code default
# is 8200 when this is unset, so always set it explicitly.
CRYPTO_SERVICE_URL=http://127.0.0.1:8132
# Set to true only when the FinPilot API sits behind a proxy you control: then X-Forwarded-For / X-Forwarded-Proto are
# believed (per-visitor rate limiting, Secure-cookie handling). Leave unset for local dev.
CRYPTO_TRUST_PROXY=

# ---- Additional variables read by the code (BUG-081). Names only; leave empty unless you use the feature. ----------
BACKEND_URL=http://127.0.0.1:8000            # frontend server-side rewrite target for /api/* (frontend/.env.local)
ALLOW_LOCALHOST_CORS=
FIRESTORE_PROJECT_ID=
FIRESTORE_EMULATOR_HOST=                     # e.g. 127.0.0.1:8080 when using the emulator
OPS_ADMIN_TOKEN=
CRYPTO_TRUSTED_HOPS=

# LLM / research providers (all optional; the offline rule engine works without them)
NVIDIA_API_KEY=
NVIDIA_CHAT_API_KEY=
NVIDIA_EVIDENCE_API_KEY=
NVIDIA_VISION_API_KEY=
NVIDIA_MODEL=
NVIDIA_CHAT_MODEL=
NVIDIA_COUNCIL_MODEL=
NVIDIA_EMBED_MODEL=
NVIDIA_VISION_MODEL=
NUGEN_API_KEY=
NUGEN_MODEL=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
EVIDENCE_DATA_MODEL=
EVIDENCE_DUPLICATE_MODEL=
EVIDENCE_FRAUD_MODEL=
EVIDENCE_MERCHANT_MODEL=
EVIDENCE_PATTERN_MODEL=
EVIDENCE_SCORER_MODEL=
EVIDENCE_SUBSCRIPTION_MODEL=
EVIDENCE_VERDICT_MODEL=
EVIDENCE_WEB_MODEL=

# Inngest
INNGEST_BASE_URL=
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_JOB_TOKEN=

# Bank data (Plaid sandbox / Account Aggregator / Setu); sandbox or mock only
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_COUNTRIES=
AA_PROVIDER=mock
AA_BASE_URL=
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_MOCK_SECRET=
AA_PRODUCT_INSTANCE_ID=
SETU_STATUS_WEBHOOK_SECRET=

# Runtime tuning
FINPILOT_DEMO_MODE=
FINPILOT_CACHE_TTL=
FINPILOT_MODEL_CACHE=
FINPILOT_NO_CACHE=

# Frontend crypto features (public values only; frontend/.env.local)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_EAS_CONTRACT=
NEXT_PUBLIC_EAS_SCHEMA_UID=
NEXT_PUBLIC_VOICE_MODE=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
