# Copy to frontend/.env.local. Names only; never commit real values. NEXT_PUBLIC_* values are inlined at build time.
# FinPilot's own names (Firebase web config, etc.) are listed in the repo-root .env.example.

# --- FinPilot API (existing) ---
# Where /api/* goes. Local dev: http://127.0.0.1:8000. Do not set on Vercel (same origin).
# The CryptPilot browser calls /api/crypto/*, which Next.js only forwards in dev when this or BACKEND_URL is set.
NEXT_PUBLIC_API_URL=
# Optional: overrides the rewrite destination in next.config.ts (server side).
BACKEND_URL=

# --- CryptPilot ---
# UID of the EAS schema registered once on Base Sepolia (testnet). Without it the sign button stays disabled and only
# the simulated attestation preview works.
NEXT_PUBLIC_EAS_SCHEMA_UID=
# Optional. Enables WalletConnect wallets; without it only browser and Coinbase wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional. "browser" forces the Web Speech API instead of POST /api/crypto/transcribe. Anything else is "auto".
NEXT_PUBLIC_VOICE_MODE=
# Optional overrides (defaults: EAS predeploy 0x4200000000000000000000000000000000000021, chain id 84532 = Base Sepolia).
# NEXT_PUBLIC_EAS_CONTRACT=
# NEXT_PUBLIC_CHAIN_ID=
#
# CRYPTO_SERVICE_URL and CRYPTO_TRUST_PROXY are read by the FinPilot API (backend), not by the frontend: see the
# repo-root .env.example.
