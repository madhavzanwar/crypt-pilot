{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "frontend/package.json", "use": "@vercel/next" },
    {
      "src": "backend/api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "500mb", "includeFiles": "backend/**", "excludeFiles": "backend/{tests,.cache,.model_cache}/**" }
    }
  ],
  "routes": [
    { "src": "/api/inngest(.*)", "dest": "frontend/api/inngest$1" },
    { "src": "/api/(.*)", "dest": "backend/api/index.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
