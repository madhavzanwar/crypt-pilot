# Run this service on any free port (`--port N --no-proxy-headers`) and set CRYPTO_SERVICE_URL=http://127.0.0.1:N on the FinPilot API.
# NOTE: the Docker image defaults to APP_ENV=prod and refuses to start with SESSION_SECRET / LOG_SALT = change_me.
APP_ENV=dev
DEMO_MODE=false
DEMO_REPLAY=false
REPLAY_FALLBACK=true
# 3100 matches scripts/run_cryptpilot_demo.*; use 3000 when running the web app with plain `npm run dev`.
FRONTEND_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3100
SESSION_SECRET=change_me
STARTING_CREDITS=3
CACHE_TTL_SECONDS=600
ADMIN_TOKEN=change_me
LOG_SALT=change_me
# Cookie: lax for same-site dev; none (requires HTTPS) when frontend and backend are on different sites
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# true only when the app is reachable solely through Fly.io's proxy (rate limits then use Fly-Client-IP)
TRUST_FLY_CLIENT_IP=false
# true ONLY when the service is reachable solely through the FinPilot bridge (it sets X-Forwarded-For); then the
# rightmost TRUSTED_PROXY_HOPS-th entry is the client. Without it every visitor behind the bridge shares one bucket.
CRYPTO_TRUST_PROXY=false
TRUSTED_PROXY_HOPS=1
# sessions idle longer than this are expired server-side (0 = never)
SESSION_TTL_DAYS=30
# free starting credits go to at most this many NEW sessions per client IP per UTC day (0 = unlimited)
FREE_SESSIONS_PER_IP_PER_DAY=25

# --- limits (slowapi syntax "N/minute|hour") ---
RATE_LIMIT_CHECK=30/minute
RATE_LIMIT_TRANSCRIBE=10/minute
RATE_LIMIT_INVOICE=20/hour
MAX_REQUEST_BYTES=6291456
MAX_AUDIO_BYTES=5242880
MAX_AUDIO_SECONDS=30
VOICE_TIMEOUT_S=15
# graph traversal caps
MAX_HOP=3
MAX_SUBGRAPH_NODES=120
MAX_FRONTIER=5000
BENCHMARK_MAX_SAMPLE=50
# verdict thresholds (artifacts/model_card.json overrides them once a model is trained)
THRESHOLD_WARN=35
THRESHOLD_BLOCK=70
DATABASE_URL=sqlite:///./data/cryptiq.sqlite

GRAPH_ENGINE=tigergraph            # tigergraph | networkx
TG_HOST=https://your-cluster.i.tgcloud.io
TG_GRAPH=Cryptiq
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
TG_QUERY_TIMEOUT_S=8

DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
OFAC_LIST_PATH=./data/labels/ofac_btc.txt
RANSOMWHERE_ENABLED=false
RANSOMWHERE_PATH=

LLM_PROVIDER=anthropic             # anthropic | openai | openai_compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_S=12
LLM_JSON_MODE=false                # true: send response_format=json_object (openai / openai_compatible; helps weaker models)
BENCHMARK_MAX_TOKENS=500000

WISPR_API_KEY=
WISPR_API_URL=https://platform-api.wisprflow.ai/api/v1/dash/api
SARVAM_API_KEY=
SARVAM_API_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=                  # verified live: saaras:v4
SARVAM_TTS_MODEL=                  # verified live: bulbul:v4-flash (speaker may stay empty)
SARVAM_TTS_SPEAKER=

DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENV=test_mode
DODO_USAGE_METER_EVENT=
PACKS_JSON=[{"id":"starter","credits":5,"priceUsd":1,"label":"Starter","dodoProductId":"pdt_xxx"}]

BTC_NETWORK=testnet                # testnet | signet
BTC_RECEIVE_ADDRESS=
BTC_EXPLORER_BASE_URL=
BTC_CONFIRMATIONS=0
BTC_SATS_PER_USD=
XMR_DEMO_ADDRESS=
INVOICE_TTL_MINUTES=30
BTC_OFFSET_SPACE=9999               # invoice-specific 1..N sats added to the price (999..99999)
MAX_OPEN_INVOICES_PER_IP=20

# --- free hosting without a volume: fetch data/ + artifacts/ from a PRIVATE Hugging Face repo at start-up ---
# (see scripts/fetch_artifacts.py). Leave empty when data/ and artifacts/ are already on disk.
ARTIFACTS_REPO=
HF_TOKEN=
ARTIFACTS_REPO_TYPE=dataset
ARTIFACTS_REVISION=main
